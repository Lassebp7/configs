#!/usr/bin/env bash
# Runs the morning-briefing agent on today's open Jira tickets.
# Skips if today's briefing already exists; pass --force to run again.
set -euo pipefail

model="lego-anthropic/claude-haiku-5-5"
date=$(date +%F)
repos="$HOME/code/lego"
briefings="/mnt/c/Users/LasseBorringPetersen/Notes/obsidian-notes/Lego/Briefings"
briefing="$briefings/$date.md"

if [[ -f "$briefing" && "${1:-}" != "--force" ]]; then
  echo "Today's briefing already exists: $briefing (use --force to regenerate)"
  exit 0
fi

mkdir -p "$briefings"

# Delete briefings older than two weeks, judged by the date in the file name
cutoff=$(date -d '14 days ago' +%F)
for old in "$briefings"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md; do
  [[ -f "$old" ]] || continue
  if [[ "$(basename "$old" .md)" < "$cutoff" ]]; then
    echo "Removing old briefing $(basename "$old")"
    rm -- "$old"
  fi
done

# Fetch only, so local branches and working trees are left untouched
for repo in "$repos"/*/; do
  echo "Fetching $(basename "$repo")"
  git -C "$repo" fetch --all --prune --quiet || echo "  fetch failed, continuing"
done

# Start the server and wait until it answers, so the run never has to boot it
echo "Starting OpenCode service"
opencode service start >/dev/null
for _ in {1..30}; do
  timeout 10 opencode api get /api/info >/dev/null 2>&1 && break
  sleep 2
done
if ! timeout 10 opencode api get /api/info >/dev/null 2>&1; then
  echo "OpenCode service did not become ready, aborting" >&2
  exit 1
fi

cd "$repos"

# Delete "Briefing <date>" sessions older than two weeks, judged by the date in the title
while IFS=$'\t' read -r id title; do
  echo "Removing old session $title ($id)"
  opencode session delete "$id" >/dev/null || echo "  delete failed, continuing"
done < <(opencode session list -n 1000 2>/dev/null \
  | awk -F'\t' -v cutoff="$cutoff" '$2 ~ /^Briefing [0-9]{4}-[0-9]{2}-[0-9]{2}$/ && substr($2, 10) < cutoff { print $1 "\t" $2 }')

status=0
timeout --kill-after=1m 30m \
  opencode run --agent morning-briefing --model "$model" --title "Briefing $date" "Run today's briefing for $date." \
  || status=$?

if [[ $status -eq 124 || $status -eq 137 ]]; then
  echo "Briefing timed out after 30 minutes; run 'briefing' to try again" >&2
elif [[ $status -ne 0 ]]; then
  echo "Briefing failed with exit code $status; run 'briefing' to try again" >&2
elif [[ ! -f "$briefing" ]]; then
  echo "Briefing finished but $briefing was not written" >&2
  status=1
fi
exit $status
